    "battle": {
        "id": "battle_pusan_perimeter_1950",
        "name": "Battle of the Pusan Perimeter",
        "part_of": "Korean War",
        "date": {
            "label": "1950-08-04–1950-09-18",
            "start": "1950-08-04",
            "end": "1950-09-18",
            "precision": "range",
            "confidence": 0.99
        },
        "summary": "1950年8月4日至9月18日，聯合國軍以釜山周邊防禦圈固守韓國東南部。北韓人民軍在8月與9月多次從馬山、洛東江突出部、大邱與浦項等方向進攻，但未能突破；9月15日仁川登陸後，北韓軍開始撤退，聯合國軍隨後自防禦圈發動突破。",
        "confidence": 0.97,
        "also_known_as": [
            "Battle of the Naktong River Defense Line",
            "Battle of Pusan Perimeter"
        ]
    },
