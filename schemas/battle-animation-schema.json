{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/battle-animation-schema.json",
  "title": "battle-animation-schema",
  "description": "A simple, wiki-friendly schema for battle history data and animation hints.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "metadata",
    "battle",
    "sides",
    "commanders",
    "actors",
    "places",
    "historical_events",
    "movements",
    "outcome",
    "sources",
    "animation_hints"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "metadata": {
      "$ref": "#/$defs/Metadata"
    },
    "battle": {
      "$ref": "#/$defs/Battle"
    },
    "sides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Side"
      }
    },
    "commanders": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Commander"
      }
    },
    "actors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Actor"
      }
    },
    "places": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Place"
      }
    },
    "historical_events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/HistoricalEvent"
      }
    },
    "movements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Movement"
      }
    },
    "outcome": {
      "$ref": "#/$defs/Outcome"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Source"
      }
    },
    "animation_hints": {
      "$ref": "#/$defs/AnimationHints"
    }
  },
  "$defs": {
    "Identifier": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
    },
    "Confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "Precision": {
      "type": "string",
      "enum": ["exact", "approximate", "inferred", "disputed", "unknown"]
    },
    "DatePrecision": {
      "type": "string",
      "enum": ["year", "month", "day", "hour", "range", "unknown"]
    },
    "DateValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "precision", "confidence"],
      "properties": {
        "label": {
          "type": "string"
        },
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        },
        "precision": {
          "$ref": "#/$defs/DatePrecision"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        }
      }
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ids"],
      "properties": {
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "Metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "created_at", "updated_at", "license", "source_system"],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "title": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "source_system": {
          "type": "string"
        },
        "wikidata_qid": {
          "type": "string"
        }
      }
    },
    "Battle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "part_of", "date", "summary", "confidence"],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "name": {
          "type": "string"
        },
        "also_known_as": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "part_of": {
          "type": "string"
        },
        "date": {
          "$ref": "#/$defs/DateValue"
        },
        "summary": {
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        }
      }
    },
    "Side": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "color", "belligerents"],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "name": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "belligerents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Belligerent"
          }
        }
      }
    },
    "Belligerent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "name": {
          "type": "string"
        },
        "wikidata_qid": {
          "type": "string"
        }
      }
    },
    "Commander": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "side_id", "confidence"],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "name": {
          "type": "string"
        },
        "side_id": {
          "$ref": "#/$defs/Identifier"
        },
        "rank_or_role": {
          "type": "string"
        },
        "wikidata_qid": {
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        }
      }
    },
    "Actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "side_id", "kind", "confidence"],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "name": {
          "type": "string"
        },
        "side_id": {
          "$ref": "#/$defs/Identifier"
        },
        "kind": {
          "type": "string",
          "enum": ["army", "corps", "division", "brigade", "regiment", "fleet", "unit", "person", "other"]
        },
        "commander_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "strength": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "confidence": {
              "$ref": "#/$defs/Confidence"
            }
          }
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        }
      }
    },
    "Place": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "geometry", "precision", "confidence"],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "name": {
          "type": "string"
        },
        "geometry": {
          "$ref": "#/$defs/Geometry"
        },
        "precision": {
          "$ref": "#/$defs/Precision"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "wikidata_qid": {
          "type": "string"
        }
      }
    },
    "Geometry": {
      "oneOf": [
        {
          "$ref": "#/$defs/Point"
        },
        {
          "$ref": "#/$defs/LineString"
        },
        {
          "$ref": "#/$defs/Polygon"
        }
      ]
    },
    "Position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "Point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": {
          "const": "Point"
        },
        "coordinates": {
          "$ref": "#/$defs/Position"
        }
      }
    },
    "LineString": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": {
          "const": "LineString"
        },
        "coordinates": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/Position"
          }
        }
      }
    },
    "Polygon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": {
          "const": "Polygon"
        },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 4,
            "items": {
              "$ref": "#/$defs/Position"
            }
          }
        }
      }
    },
    "EventType": {
      "type": "string",
      "enum": [
        "advance",
        "retreat",
        "attack",
        "defend",
        "capture",
        "surrender",
        "reinforcement",
        "bombardment",
        "landing",
        "other"
      ]
    },
    "HistoricalEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "time", "description", "actor_ids", "place_ids", "precision", "confidence", "source_ids"],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "type": {
          "$ref": "#/$defs/EventType"
        },
        "title": {
          "type": "string"
        },
        "time": {
          "$ref": "#/$defs/DateValue"
        },
        "description": {
          "type": "string"
        },
        "actor_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "target_actor_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "place_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "precision": {
          "$ref": "#/$defs/Precision"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        }
      }
    },
    "Movement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "event_id", "actor_id", "path", "precision", "confidence"],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "event_id": {
          "$ref": "#/$defs/Identifier"
        },
        "actor_id": {
          "$ref": "#/$defs/Identifier"
        },
        "from_place_id": {
          "$ref": "#/$defs/Identifier"
        },
        "to_place_id": {
          "$ref": "#/$defs/Identifier"
        },
        "path": {
          "$ref": "#/$defs/LineString"
        },
        "precision": {
          "$ref": "#/$defs/Precision"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        }
      }
    },
    "Outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "winner_side_ids", "confidence", "source_ids"],
      "properties": {
        "summary": {
          "type": "string"
        },
        "winner_side_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "casualties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Casualty"
          }
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        }
      }
    },
    "Casualty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["side_id", "label", "confidence"],
      "properties": {
        "side_id": {
          "$ref": "#/$defs/Identifier"
        },
        "label": {
          "type": "string"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        }
      }
    },
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "url", "retrieved_at", "license"],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "retrieved_at": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "AnimationHints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["map", "style", "timeline"],
      "properties": {
        "map": {
          "type": "object",
          "additionalProperties": false,
          "required": ["initial_center", "initial_zoom"],
          "properties": {
            "initial_center": {
              "$ref": "#/$defs/Position"
            },
            "initial_zoom": {
              "type": "number"
            },
            "bounds_padding": {
              "type": "number"
            }
          }
        },
        "style": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "side_colors": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "event_icons": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "movement_line_width": {
              "type": "number"
            }
          }
        },
        "timeline": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "default_event_duration_ms": {
              "type": "number"
            },
            "ordered_event_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Identifier"
              }
            }
          }
        },
        "camera": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["event_id", "center"],
            "properties": {
              "event_id": {
                "$ref": "#/$defs/Identifier"
              },
              "center": {
                "$ref": "#/$defs/Position"
              },
              "zoom": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  }
}
